# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# Supabase project (Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Environment: development | staging | production
APP_ENV=development

# AI gateway — the client never talks to an LLM vendor directly; it calls
# a Supabase Edge Function which holds the real provider key server-side.
# This is only the *name* the client sends so the gateway can log which
# feature triggered the call, not a vendor credential.
AI_GATEWAY_FUNCTION_NAME=ai-coach-gateway
AI_PLAN_GATEWAY_FUNCTION_NAME=ai-plan-generator
AI_PROGRAM_OVERVIEW_FUNCTION_NAME=ai-program-overview
